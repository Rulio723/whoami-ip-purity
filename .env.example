PORT=3000
HOST=0.0.0.0
TRUST_CF_CONNECTING_IP=true
CLOUDFLARE_RADAR_API_TOKEN=
DEV_IP_OVERRIDE=

# Optional custom production database files. Leave blank to use the
# npm-packaged GeoLite2 City and ASN databases.
MAXMIND_CITY_DB=
MAXMIND_ASN_DB=

# Required only by: npm run maxmind:update
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_DIR=./databases

# Required by the cloudflared service in compose.yaml.
CLOUDFLARE_TUNNEL_TOKEN=
