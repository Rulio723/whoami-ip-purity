{
  "name": "whoami-fingerprint-check",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "maxmind:update": "node scripts/download-maxmind.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@maxmind/geoip2-node": "7.1.0",
    "@maxminddatabase/geolite2": "1.0.292",
    "express": "5.2.1",
    "htmx.org": "4.0.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "vite": "8.2.2"
  },
  "description": "Cloudflare-fronted Node.js whoami service backed by local MaxMind GeoLite2 City and ASN databases"
}
